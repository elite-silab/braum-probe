# Braum 本地开发配置
#
# 使用方法（无需敲复制命令）：
# 1. 在文件管理器中复制本文件；
# 2. 将副本改名为 .env；
# 3. 按下面的注释修改后保存。
#
# 这个文件只用于本机开发。生产环境的密钥请填写到 Cloudflare 控制台，
# 不要把真实生产密钥写进本文件或提交到 Git。

# ---------- 新手通常只需要看这里 ----------

# 本地管理后台首次登录密码
ADMIN_INITIAL_PASSWORD=braum-local-admin

# ---------- 本地安全密钥 ----------
# 仅供本机开发；正式环境必须在 Cloudflare 控制台换成三个互不相同的随机长字符串。

JWT_SECRET=local-only-jwt-secret-change-before-production
JWT_REFRESH_SECRET=local-only-refresh-secret-change-before-production
ENCRYPTION_KEY=local-only-encryption-key-change-before-production

# ---------- 一般不需要修改 ----------

# 后台生成 Agent 安装命令时使用的 API 地址
AGENT_API_URL=http://localhost:3000

# Agent 下载目录。本地开发不安装 Agent 时可以保持原样
AGENT_RELEASE_BASE_URL=https://github.com/elite-silab/braum-probe/releases/download/agent-v0.1.2

# 可选：Telegram 默认机器人 Token；不用 Telegram 时留空
TELEGRAM_BOT_TOKEN=
