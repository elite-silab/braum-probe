{
  "name": "@braum/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env-file ../../.env",
    "build": "WRANGLER_LOG_PATH=${WRANGLER_LOG_PATH:-/tmp/braum-wrangler.log} wrangler deploy --dry-run --outdir=dist --env=",
    "deploy": "wrangler deploy",
    "deploy:full": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@braum/shared": "workspace:*",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
