{
  "name": "@braum/web",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build --config ../../wrangler.jsonc",
    "deploy:worker": "wrangler d1 migrations apply DB --remote --config ../../wrangler.jsonc && wrangler deploy --config ../../wrangler.jsonc",
    "deploy:full": "pnpm build:worker && pnpm run deploy:worker",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "echo 'no tests configured'"
  },
  "dependencies": {
    "@braum/shared": "workspace:*",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.8.0",
    "wrangler": "^4.114.0"
  }
}
