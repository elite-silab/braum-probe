---
// Braum 布隆 CF 探针 — 管理后台布局
import '../styles/global.css'
import ThemeSwitcher from '../components/ThemeSwitcher'
import AdminSidebar from '../components/admin/AdminSidebar'

interface Props {
  title?: string
}

const { title = '管理后台 — Braum 探针' } = Astro.props
---

<!doctype html>
<html lang="zh-CN" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // 初始化主题（避免闪烁）
      const savedTheme = localStorage.getItem('braum-theme') || 'default'
      const isDark = localStorage.getItem('braum-dark') === 'true'

      if (savedTheme !== 'default') document.documentElement.setAttribute('data-theme', savedTheme)
      if (isDark || savedTheme === 'hoshizora') document.documentElement.classList.add('dark')

      // 登录检测：未登录跳转登录页
      if (!localStorage.getItem('token')) {
        window.location.replace('/admin/login')
      }
    </script>
  </head>
  <body class="h-full" style="background-color: var(--surface-body);">
    <div class="flex h-full">
      <!-- 侧边栏 -->
      <AdminSidebar client:load />

      <!-- 主内容区 -->
      <div class="flex flex-1 flex-col overflow-hidden">
        <!-- 顶部工具栏 -->
        <header class="theme-header flex h-14 items-center justify-between border-b px-6">
          <div class="flex items-center gap-2 text-sm theme-text-secondary">
            <img src="/logo-icon.svg" alt="Braum" class="h-6 w-6" />
            <a href="/admin" class="hover:opacity-80 font-medium">管理后台</a>
          </div>
          <div class="flex items-center gap-3">
            <ThemeSwitcher client:load />
            <div class="relative" id="user-menu">
              <button id="user-avatar" class="h-8 w-8 rounded-full flex items-center justify-center text-white text-sm font-medium cursor-pointer transition-transform hover:scale-105" style="background-color: var(--theme-primary);">
                A
              </button>
              <div id="user-dropdown" class="hidden absolute right-0 top-10 z-50 w-56 overflow-hidden rounded-xl border shadow-lg" style="background-color: var(--surface-card, #fff); border-color: var(--surface-border, #e2e8f0);">
                <div class="border-b px-4 py-3" style="border-color: var(--surface-border, #e2e8f0);">
                  <p id="dropdown-name" class="text-sm font-medium" style="color: var(--surface-text, #1e293b);">Admin</p>
                  <p id="dropdown-email" class="mt-0.5 text-xs" style="color: var(--surface-text-secondary, #64748b);">admin@braum.local</p>
                </div>
                <div class="p-1">
                  <a href="/" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm transition-colors hover:opacity-80" style="color: var(--surface-text, #1e293b);">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
                    返回前台
                  </a>
                  <button id="logout-btn" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-red-600 transition-colors hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-900/20">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg>
                    退出登录
                  </button>
                </div>
              </div>
            </div>
          </div>
        </header>

    <script is:inline>
      // 用户菜单交互
      (function() {
        const avatar = document.getElementById('user-avatar')
        const dropdown = document.getElementById('user-dropdown')
        const logoutBtn = document.getElementById('logout-btn')
        const nameEl = document.getElementById('dropdown-name')
        const emailEl = document.getElementById('dropdown-email')

        // 显示用户信息
        try {
          const user = JSON.parse(localStorage.getItem('user') || '{}')
          const name = user.name || 'Admin'
          const email = user.email || 'admin@braum.local'
          avatar.textContent = name.charAt(0).toUpperCase()
          nameEl.textContent = name
          emailEl.textContent = email
        } catch {
          // Ignore malformed local display data; API authorization remains authoritative.
        }

        // 下拉菜单开关
        avatar.addEventListener('click', (e) => {
          e.stopPropagation()
          dropdown.classList.toggle('hidden')
        })

        // 点击外部关闭
        document.addEventListener('click', (e) => {
          if (!document.getElementById('user-menu').contains(e.target)) {
            dropdown.classList.add('hidden')
          }
        })

        // 退出登录
        logoutBtn.addEventListener('click', () => {
          localStorage.removeItem('token')
          localStorage.removeItem('refresh_token')
          localStorage.removeItem('user')
          window.location.replace('/admin/login')
        })
      })()
    </script>

        <!-- 页面内容 -->
        <main class="flex-1 overflow-y-auto p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
