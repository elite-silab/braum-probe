---
// Braum 布隆 CF 探针 — 历史数据页
import BaseLayout from '../layouts/BaseLayout.astro'
import HistoryViewer from '../components/HistoryViewer'
---

<BaseLayout title="历史数据 — Braum 探针">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h1 class="mb-4 text-3xl font-bold text-slate-900 dark:text-white">历史数据</h1>
    <p class="mb-8 text-slate-500 dark:text-slate-400">
      查看各 VPS Agent 在节点本地执行的 HTTP/DNS 探测记录
    </p>

    <HistoryViewer client:load />
  </div>
</BaseLayout>
