---
// Braum 布隆 CF 探针 — 公告列表页
import BaseLayout from '../../layouts/BaseLayout.astro'

// 公告状态
type IncidentStatus = 'investigating' | 'identified' | 'monitoring' | 'resolved'

interface Incident {
  id: string
  title: string
  status: IncidentStatus
  created_at: string
  updated_at: string
}

// 服务端获取公告数据
const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787'

let incidents: Incident[] = []

try {
  const res = await fetch(`${API_BASE}/api/v1/incidents`)
  const data = await res.json()
  incidents = data?.data?.results || data?.data || []
  if (!Array.isArray(incidents)) incidents = []
} catch {
  incidents = []
}

const statusLabels: Record<IncidentStatus, string> = {
  investigating: '调查中',
  identified: '已确认',
  monitoring: '观察中',
  resolved: '已解决',
}

const statusColors: Record<IncidentStatus, string> = {
  investigating: 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400',
  identified: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400',
  monitoring: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
  resolved: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400',
}
---

<BaseLayout title="公告 — Braum 探针">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h1 class="mb-4 text-3xl font-bold text-slate-900 dark:text-white">系统公告</h1>
    <p class="mb-8 text-slate-500 dark:text-slate-400">
      查看系统维护、故障通知和事件记录
    </p>

    {incidents.length === 0 ? (
      <div class="card text-center">
        <svg class="mx-auto h-12 w-12 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="mt-4 text-slate-500 dark:text-slate-400">当前无活跃公告，所有系统运行正常</p>
      </div>
    ) : (
      <div class="space-y-4">
        {incidents.map((incident) => (
          <a href={`/incidents/${incident.id}`} class="card block transition-shadow hover:shadow-md">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="font-medium text-slate-900 dark:text-white">{incident.title}</h3>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                  创建于 {incident.created_at}
                </p>
              </div>
              <span class={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium ${statusColors[incident.status]}`}>
                {statusLabels[incident.status]}
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
