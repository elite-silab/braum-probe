---
// Braum 布隆 CF 探针 — 节点详情页
import BaseLayout from '../../layouts/BaseLayout.astro'
import StatusDot from '../../components/StatusDot'

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787'
const { id } = Astro.params

let node: any = null
let probeResults: any[] = []
let uptime24h = '--'
let uptime7d = '--'
let uptime30d = '--'
let pct24h = 0
let pct7d = 0
let pct30d = 0
let latestMetrics: any = null
let agent: any = null
let metricsHistory: any[] = []

if (id) {
  try {
    const res = await fetch(`${API_BASE}/api/v1/nodes/${id}`)
    const data = await res.json()
    node = data?.data || null
    latestMetrics = node?.latest_metrics || null
    agent = node?.agent || null
    metricsHistory = Array.isArray(node?.metrics_history) ? node.metrics_history : []
    if (node?.availability_windows) {
      const windowValue = (value: number | null) => value == null ? { text: '--', pct: 0 } : { text: `${value.toFixed(2)}%`, pct: value }
      const w24 = windowValue(node.availability_windows.hours_24)
      const w7 = windowValue(node.availability_windows.days_7)
      const w30 = windowValue(node.availability_windows.days_30)
      uptime24h = w24.text; pct24h = w24.pct
      uptime7d = w7.text; pct7d = w7.pct
      uptime30d = w30.text; pct30d = w30.pct
    }
  } catch { node = null }

  // 获取最近 30 天探测结果用于可用率计算
  const thirtyDaysAgo = new Date(Date.now() - 30 * 86400000).toISOString()
  try {
    const res = await fetch(`${API_BASE}/api/v1/probe-results?node_id=${id}&page_size=200&start_time=${thirtyDaysAgo}`)
    const data = await res.json()
    probeResults = data?.data?.results || data?.data || []
    if (!Array.isArray(probeResults)) probeResults = []
  } catch { probeResults = [] }

  // 计算可用率
  const now = Date.now()
  const calcUptime = (hours: number) => {
    const cutoff = now - hours * 3600000
    const filtered = probeResults.filter((r: any) => new Date(r.probe_at).getTime() >= cutoff)
    if (filtered.length === 0) return { text: '--', pct: 0 }
    const successCount = filtered.filter((r: any) => r.success).length
    const pct = (successCount / filtered.length) * 100
    return { text: pct.toFixed(2) + '%', pct }
  }

  if (!node?.availability_windows) {
    const u24 = calcUptime(24)
    const u7 = calcUptime(168)
    const u30 = calcUptime(720)
    uptime24h = u24.text; pct24h = u24.pct
    uptime7d = u7.text; pct7d = u7.pct
    uptime30d = u30.text; pct30d = u30.pct
  }
}

const statusMap: Record<string, string> = {
  active: '在线',
  online: '在线',
  offline: '离线',
  degraded: '降级',
}

const regionLabels: Record<string, string> = {
  asia: '亚洲', europe: '欧洲', north_america: '北美洲',
  south_america: '南美洲', oceania: '大洋洲', africa: '非洲',
}

const percent = (used: number, total: number) => total > 0 ? Math.min(100, Math.max(0, used / total * 100)) : 0
const memoryPercent = latestMetrics ? percent(latestMetrics.memory_used_bytes, latestMetrics.memory_total_bytes) : 0
const diskPercent = latestMetrics ? percent(latestMetrics.disk_used_bytes, latestMetrics.disk_total_bytes) : 0
const formatBytes = (value: number) => {
  if (!Number.isFinite(value)) return '--'
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let size = value
  let unit = 0
  while (size >= 1024 && unit < units.length - 1) { size /= 1024; unit++ }
  return `${size.toFixed(unit >= 3 ? 1 : 0)} ${units[unit]}`
}
const seriesPoints = (values: number[], max = 100) => values.map((value, index) => {
  const x = values.length <= 1 ? 0 : index / (values.length - 1) * 600
  const y = 100 - Math.min(max, Math.max(0, value)) / max * 94 - 3
  return `${x},${y}`
}).join(' ')
const cpuPoints = seriesPoints(metricsHistory.map((item: any) => Number(item.cpu_usage) || 0))
const memoryPoints = seriesPoints(metricsHistory.map((item: any) => percent(Number(item.memory_used_bytes), Number(item.memory_total_bytes))))
---

<BaseLayout title={`${node?.name || '节点'} — Braum 探针`}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- 面包屑 -->
    <nav class="mb-6 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-slate-900 dark:hover:text-white">总览</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white">{node?.name || `节点 ${id}`}</span>
    </nav>

    {node ? (
      <>
        <!-- 节点信息头部 -->
        <div class="mb-6 rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <div class="flex items-start justify-between">
            <div>
              <h1 class="text-2xl font-bold text-slate-900 dark:text-white">{node.name}</h1>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                ID: <code class="rounded bg-slate-100 px-2 py-0.5 dark:bg-slate-700">{id}</code>
              </p>
            </div>
            <div class="flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-sm font-medium dark:bg-slate-800">
              <StatusDot client:load status={node.status === 'active' ? 'online' : node.status === 'offline' ? 'offline' : 'degraded'} size="sm" />
              <span>{agent?.registration_status === 'pending' ? '等待安装 Agent' : statusMap[node.status] || node.status}</span>
            </div>
          </div>

          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400">主机名</p>
              <p class="mt-1 font-medium text-slate-900 dark:text-white">{agent?.hostname || '尚未上报'}</p>
            </div>
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400">区域</p>
              <p class="mt-1 font-medium text-slate-900 dark:text-white">{node.country === '待识别' ? '安装后自动识别' : (regionLabels[node.region] || node.region)}</p>
            </div>
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400">位置</p>
              <p class="mt-1 font-medium text-slate-900 dark:text-white">{node.city === '待识别' ? '安装后自动识别' : ([node.city, node.country].filter(Boolean).join(', ') || '--')}</p>
            </div>
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400">探测间隔</p>
              <p class="mt-1 font-medium text-slate-900 dark:text-white">{node.probe_interval || 60}s</p>
            </div>
          </div>
        </div>

        <!-- VPS 资源指标 -->
        <section class="mb-6">
          <div class="mb-4 flex items-end justify-between">
            <div>
              <h2 class="text-lg font-semibold text-slate-900 dark:text-white">VPS 资源</h2>
              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                {latestMetrics?.collected_at ? `采集于 ${new Date(latestMetrics.collected_at).toLocaleString('zh-CN')}` : '等待 Agent 首次上报'}
              </p>
            </div>
            {agent?.agent_version && <span class="rounded-full bg-brand-50 px-3 py-1 text-xs text-brand-700 dark:bg-brand-950/40 dark:text-brand-300">Agent {agent.agent_version}</span>}
          </div>
          {latestMetrics ? (
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {[
                { label: 'CPU', value: `${Number(latestMetrics.cpu_usage).toFixed(1)}%`, pct: Number(latestMetrics.cpu_usage), detail: `${agent?.cpu_cores || '--'} 核` },
                { label: '内存', value: `${memoryPercent.toFixed(1)}%`, pct: memoryPercent, detail: `${formatBytes(latestMetrics.memory_used_bytes)} / ${formatBytes(latestMetrics.memory_total_bytes)}` },
                { label: '磁盘', value: `${diskPercent.toFixed(1)}%`, pct: diskPercent, detail: `${formatBytes(latestMetrics.disk_used_bytes)} / ${formatBytes(latestMetrics.disk_total_bytes)}` },
                { label: '系统负载', value: Number(latestMetrics.load_1).toFixed(2), pct: Math.min(100, Number(latestMetrics.load_1) / Math.max(1, Number(agent?.cpu_cores) || 1) * 100), detail: `5m ${Number(latestMetrics.load_5).toFixed(2)} · 15m ${Number(latestMetrics.load_15).toFixed(2)}` },
              ].map((metric) => (
                <div class="rounded-2xl border border-slate-200/80 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
                  <p class="text-xs font-medium uppercase tracking-wider text-slate-400">{metric.label}</p>
                  <p class="mt-2 font-mono text-2xl font-bold text-slate-950 dark:text-white">{metric.value}</p>
                  <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
                    <div class:list={['h-full rounded-full', metric.pct >= 90 ? 'bg-red-500' : metric.pct >= 75 ? 'bg-amber-500' : 'bg-emerald-500']} style={`width:${metric.pct}%`} />
                  </div>
                  <p class="mt-2 truncate text-xs text-slate-500 dark:text-slate-400">{metric.detail}</p>
                </div>
              ))}
            </div>
          ) : (
            <div class="rounded-2xl border border-dashed border-slate-300 bg-white/70 p-10 text-center dark:border-slate-700 dark:bg-slate-900/70">
              <p class="font-medium text-slate-700 dark:text-slate-200">还没有收到资源指标</p>
              <p class="mt-1 text-sm text-slate-500">请在管理后台为该节点生成安装命令，并在 VPS 上启动 Agent。</p>
            </div>
          )}
        </section>

        {metricsHistory.length > 1 && (
          <div class="card mb-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-lg font-semibold text-slate-900 dark:text-white">24 小时资源趋势</h2>
              <div class="flex gap-4 text-xs text-slate-500">
                <span class="flex items-center gap-1.5"><i class="h-2 w-2 rounded-full bg-brand-500"></i>CPU</span>
                <span class="flex items-center gap-1.5"><i class="h-2 w-2 rounded-full bg-emerald-500"></i>内存</span>
              </div>
            </div>
            <svg viewBox="0 0 600 100" class="mt-5 h-36 w-full" preserveAspectRatio="none" role="img" aria-label="CPU 和内存使用率趋势">
              <line x1="0" y1="97" x2="600" y2="97" stroke="currentColor" class="text-slate-200 dark:text-slate-700" />
              <line x1="0" y1="50" x2="600" y2="50" stroke="currentColor" stroke-dasharray="4 6" class="text-slate-200 dark:text-slate-700" />
              <polyline points={cpuPoints} fill="none" stroke="#3b82f6" stroke-width="2" vector-effect="non-scaling-stroke" />
              <polyline points={memoryPoints} fill="none" stroke="#10b981" stroke-width="2" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
        )}

        {agent?.registration_status === 'registered' && (
          <div class="card mb-6">
            <h2 class="mb-4 text-lg font-semibold text-slate-900 dark:text-white">主机信息</h2>
            <dl class="grid gap-x-6 gap-y-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
              <div><dt class="text-slate-500">系统</dt><dd class="mt-1 font-medium text-slate-900 dark:text-white">{[agent.platform || agent.os, agent.arch].filter(Boolean).join(' · ')}</dd></div>
              <div><dt class="text-slate-500">内核</dt><dd class="mt-1 font-mono text-xs text-slate-900 dark:text-white">{agent.kernel_version || '--'}</dd></div>
              <div><dt class="text-slate-500">处理器</dt><dd class="mt-1 truncate font-medium text-slate-900 dark:text-white" title={agent.cpu_model}>{agent.cpu_model || '--'}</dd></div>
              <div><dt class="text-slate-500">运行时间</dt><dd class="mt-1 font-medium text-slate-900 dark:text-white">{latestMetrics ? `${Math.floor(latestMetrics.uptime_seconds / 86400)} 天` : '--'}</dd></div>
            </dl>
          </div>
        )}

        <!-- 最近探测结果 -->
        <div class="card mb-6">
          <h2 class="mb-4 text-lg font-semibold text-slate-900 dark:text-white">最近探测</h2>
          {probeResults.length > 0 ? (
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
                  <tr>
                    <th class="px-4 py-3 font-medium text-slate-500 dark:text-slate-400">目标</th>
                    <th class="px-4 py-3 font-medium text-slate-500 dark:text-slate-400">状态</th>
                    <th class="px-4 py-3 font-medium text-slate-500 dark:text-slate-400">延迟</th>
                    <th class="px-4 py-3 font-medium text-slate-500 dark:text-slate-400">HTTP Code</th>
                    <th class="px-4 py-3 font-medium text-slate-500 dark:text-slate-400">时间</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                  {probeResults.slice(0, 20).map((r: any) => (
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
                      <td class="px-4 py-3 text-slate-700 dark:text-slate-300">{r.target_name || r.target_id?.slice(0, 8) || '--'}</td>
                      <td class="px-4 py-3">
                        <span class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ${r.success ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400'}`}>
                          {r.success ? '成功' : '失败'}
                        </span>
                      </td>
                      <td class="px-4 py-3 text-slate-700 dark:text-slate-300">{r.latency_ms ? `${r.latency_ms}ms` : '--'}</td>
                      <td class="px-4 py-3 text-slate-500 dark:text-slate-400">{r.status_code || '--'}</td>
                      <td class="px-4 py-3 text-slate-500 dark:text-slate-400">
                        {r.probe_at ? new Date(r.probe_at).toLocaleString('zh-CN') : '--'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="text-center text-slate-400 dark:text-slate-500">暂无探测数据</p>
          )}
        </div>

        <!-- 可用率进度条（代替图表） -->
        <div class="card">
          <h2 class="mb-4 text-lg font-semibold text-slate-900 dark:text-white">可用率</h2>
          <div class="space-y-3">
            <div>
              <div class="flex justify-between text-sm">
                <span class="text-slate-500 dark:text-slate-400">24 小时</span>
                <span class="font-medium text-slate-900 dark:text-white">{uptime24h}</span>
              </div>
              <div class="mt-1 h-2 rounded-full bg-slate-100 dark:bg-slate-700">
                <div class="h-2 rounded-full bg-emerald-500" style={`width: ${pct24h}%`} />
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm">
                <span class="text-slate-500 dark:text-slate-400">7 天</span>
                <span class="font-medium text-slate-900 dark:text-white">{uptime7d}</span>
              </div>
              <div class="mt-1 h-2 rounded-full bg-slate-100 dark:bg-slate-700">
                <div class="h-2 rounded-full bg-emerald-500" style={`width: ${pct7d}%`} />
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm">
                <span class="text-slate-500 dark:text-slate-400">30 天</span>
                <span class="font-medium text-slate-900 dark:text-white">{uptime30d}</span>
              </div>
              <div class="mt-1 h-2 rounded-full bg-slate-100 dark:bg-slate-700">
                <div class="h-2 rounded-full bg-emerald-500" style={`width: ${pct30d}%`} />
              </div>
            </div>
          </div>
        </div>
      </>
    ) : (
      <div class="card text-center">
        <p class="text-slate-500 dark:text-slate-400">节点不存在或无法访问</p>
        <a href="/" class="mt-4 inline-block text-brand-600 hover:text-brand-700 dark:text-brand-400">
          返回首页
        </a>
      </div>
    )}
  </div>
</BaseLayout>
